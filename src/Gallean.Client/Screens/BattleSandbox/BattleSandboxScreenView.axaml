<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Gallean.Client"
             x:Class="Gallean.Client.BattleSandboxScreenView"
             x:DataType="local:BattleSandboxScreenViewModel">

  <!-- Gallean Upgrade: the battle sandbox (docs/battle-ai-designer.md phase 3). Parts copied from the game's own
       screens: the party grid and level bar of the map editor's army screen, round lord portraits of the diplomacy
       screen, the round city picture of the city screen, and the menu backdrop of the editor modes. -->
  <UserControl.Styles>
    <Style Selector="Border.rune.purchase">
      <Setter Property="ToolTip.Tip" Value="{local:Text 'Add a unit'}" />
    </Style>
    <Style Selector="Button.owner">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="46" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.owner Border.frame">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Button.owner.selected Border.frame">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Button.owner:pointerover Border.frame">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ComboBox.sandbox">
      <Setter Property="Height" Value="30" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <!-- Equipment sockets, copied from the army tab (StackTabView), smaller to fit seven in a row. -->
    <Style Selector="Button.equipment-slot">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="46" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.equipment-slot /template/ local|PlateChrome#PlateChrome">
      <Setter Property="Shape" Value="Square" />
    </Style>
    <Style Selector="Button.equipment-slot local|SpriteVisual">
      <Setter Property="Margin" Value="-6" />
    </Style>
    <Style Selector="Button.equipment-slot local|IconVisual">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Opacity" Value="0.4" />
      <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    </Style>
    <Style Selector="Border.slot-problem">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="TextBlock.field">
      <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <DataTemplate x:Key="SandboxSideTemplate" x:DataType="local:BattleSandboxSideViewModel">
      <ContentControl Classes="ornament-panel" Background="{StaticResource CapitalScenePanelBodyGradientBrush}">
        <StackPanel Width="390" Margin="16,10" Spacing="6">
          <local:OutlinedTextBlock Text="{Binding Title}" Classes="object-name title" HorizontalAlignment="Center" />

          <ItemsControl ItemsSource="{Binding Owners}" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:BattleSandboxOwnerViewModel">
                <Button Classes="owner"
                        Classes.selected="{Binding IsSelected}"
                        Command="{Binding SelectCommand}"
                        ToolTip.Tip="{Binding Name}">
                  <Border Classes="frame" Width="44" Height="44" CornerRadius="22" BorderThickness="2" ClipToBounds="True">
                    <local:SpriteVisual SpriteKey="{Binding PortraitKey}" Stretch="UniformToFill" />
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding OwnerName}" Classes="caption" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />

          <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" ToolTip.Tip="{local:Text 'Leadership'}">
            <local:OutlinedTextBlock Text="{local:Text 'Party'}" Classes="object-name row" />
            <local:OutlinedTextBlock Text="{Binding Group.CapacityText}" Classes="object-name row" Foreground="{StaticResource SecondaryTextBrush}" />
            <local:IconVisual Moniker="Leadership" Width="18" Height="18" Foreground="{StaticResource SecondaryTextBrush}" />
          </StackPanel>
          <Viewbox Classes="unit-grid-container" Height="196" HorizontalAlignment="Center">
            <ItemsControl Classes="unit-grid focus-group"
                          ItemsSource="{Binding UnitGrid.Slots}"
                          ItemTemplate="{StaticResource UnitGridSlotTemplate}"
                          ItemContainerTheme="{StaticResource UnitGridSlotContainerTheme}" />
          </Viewbox>

          <!-- The leader's items, like the army tab's equipment sockets (phase 4). -->
          <ItemsControl ItemsSource="{Binding EquipmentSlots}" HorizontalAlignment="Center" IsVisible="{Binding CanEquip}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="5" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:BattleSandboxEquipmentSlotViewModel">
                <Panel ToolTip.Tip="{Binding ToolTip}">
                  <Button Classes="socket equipment-slot" Command="{Binding ClickCommand}">
                    <Panel>
                      <local:SpriteVisual SpriteKey="{Binding SpriteKey}" Stretch="Uniform" IsVisible="{Binding HasItem}" />
                      <local:IconVisual Moniker="{Binding Icon}" IsVisible="{Binding !HasItem}" />
                    </Panel>
                  </Button>
                  <Border Classes="slot-problem" IsVisible="{Binding HasProblem}" />
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{local:Text 'Battle AI'}" Classes="caption field" />
            <ComboBox Grid.Row="0" Grid.Column="1" Classes="sandbox" ItemsSource="{Binding Ais}" SelectedItem="{Binding SelectedAi}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="local:MapEditorLabeled">
                  <TextBlock Text="{Binding Label}" Classes="caption" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <CheckBox Grid.Row="1" Grid.Column="1"
                      IsChecked="{Binding AllowsAnything}"
                      ToolTip.Tip="{local:Text 'Skip the game rules for this army: no leader needed, no leadership limit.'}">
              <TextBlock Text="{local:Text 'Anything goes'}" Classes="caption" />
            </CheckBox>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="{local:Text 'Upgrades'}" Classes="caption field" IsVisible="{Binding CanEquip}" />
            <Button Grid.Row="4" Grid.Column="1" Classes="pill" Height="30" Padding="12,0" HorizontalAlignment="Left"
                    IsVisible="{Binding CanEquip}" Command="{Binding ChooseUpgradesCommand}"
                    ToolTip.Tip="{local:Text 'The leader abilities learned on level-up, like in the game'}">
              <TextBlock Text="{Binding UpgradesText}" Classes="caption" />
            </Button>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="{local:Text 'Save as'}" Classes="caption field" />
            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox Grid.Column="0" Text="{Binding PresetName}" MaxLength="40" Height="30" Watermark="{local:Text 'Army name'}" />
              <Button Grid.Column="1" Classes="pill" Height="30" Padding="12,0" Content="{local:Text 'Save'}" Command="{Binding SavePresetCommand}" />
            </Grid>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="{local:Text 'Saved armies'}" Classes="caption field" />
            <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
              <ComboBox Grid.Column="0" Classes="sandbox" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" PlaceholderText="{local:Text 'None yet'}" />
              <Button Grid.Column="1" Classes="pill" Height="30" Padding="12,0" Content="{local:Text 'Load'}" Command="{Binding LoadPresetCommand}" />
              <Button Grid.Column="2" Classes="pill" Height="30" Padding="12,0" Content="{local:Text 'Delete'}" Command="{Binding DeletePresetCommand}" />
            </Grid>
          </Grid>
        </StackPanel>
      </ContentControl>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Background="{StaticResource ScenarioSelectBackdropBrush}" ClipToBounds="True">
    <local:CoverBoxDecorator Classes="menu-background" DataContext="{Binding Background}">
      <local:MainMenuBackgroundView />
    </local:CoverBoxDecorator>
    <Border Classes="menu-overlay" Width="1366" />

    <Grid RowDefinitions="Auto,*,Auto" Margin="8,16,8,16" HorizontalAlignment="Center" VerticalAlignment="Center">
      <local:OutlinedTextBlock Grid.Row="0" Text="{local:Text 'Battle sandbox'}" Classes="h1" HorizontalAlignment="Center" Foreground="{StaticResource ScenarioSelectAccentBrush}" Margin="0,0,0,12" />

      <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="12">
        <ContentControl Grid.Column="0" Content="{Binding Attacker}" ContentTemplate="{StaticResource SandboxSideTemplate}" VerticalAlignment="Top" />

        <!-- The battlefield -->
        <ContentControl Grid.Column="1" Classes="ornament-panel" Background="{StaticResource CapitalScenePanelBodyGradientBrush}" VerticalAlignment="Top">
          <StackPanel Width="240" Margin="14,12" Spacing="10">
            <local:OutlinedTextBlock Text="{local:Text 'Battlefield'}" Classes="object-name title" HorizontalAlignment="Center" />
            <ItemsControl ItemsSource="{Binding Places}" HorizontalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:MapEditorLabeled">
                  <Button Classes="pill"
                          Height="28"
                          Padding="10,0"
                          FontSize="{StaticResource FontSizeSm}"
                          Content="{Binding Label}"
                          Command="{Binding $parent[UserControl].((local:BattleSandboxScreenViewModel)DataContext).SetPlaceCommand}"
                          CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Panel Width="120" Height="120" HorizontalAlignment="Center">
              <local:SpriteVisual SpriteKey="{Binding PlaceImageKey}" Stretch="UniformToFill" IsVisible="{Binding PlaceImageKey, Converter={x:Static ObjectConverters.IsNotNull}}">
                <local:SpriteVisual.Clip>
                  <EllipseGeometry Rect="0,0,120,120" />
                </local:SpriteVisual.Clip>
              </local:SpriteVisual>
              <local:IconVisual Moniker="Stack" Width="40" Height="40" Foreground="{StaticResource SecondaryTextBrush}" IsVisible="{Binding IsOpenField}" />
              <Ellipse Stroke="{StaticResource AccentSecondaryBrush}" StrokeThickness="1" />
            </Panel>
            <TextBlock Text="{Binding PlaceTitle}" Classes="body" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" IsVisible="{Binding IsCity}">
              <Button Classes="pill" Width="28" Height="28" Padding="0" Content="-" Command="{Binding CityLevelDownCommand}" />
              <TextBlock Text="{local:Text 'Level'}" Classes="caption field" />
              <Button Classes="pill" Width="28" Height="28" Padding="0" Content="+" Command="{Binding CityLevelUpCommand}" />
            </StackPanel>
            <CheckBox IsChecked="{Binding AsGarrison}" IsEnabled="{Binding HasPlace}" HorizontalAlignment="Center"
                      ToolTip.Tip="{local:Text 'The defender fights as the garrison: no leader, a capital keeps its guardian.'}">
              <TextBlock Text="{local:Text 'Defends as the garrison'}" Classes="caption" />
            </CheckBox>
            <local:OrnamentDivider Classes="section" />
            <TextBlock Text="{local:Text 'Difficulty'}" Classes="caption field" HorizontalAlignment="Center" />
            <ComboBox Classes="sandbox" ItemsSource="{Binding Difficulties}" SelectedItem="{Binding SelectedDifficulty}"
                      ToolTip.Tip="{local:Text 'The difficulty sets the accuracy and experience bonuses of computer players.'}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="local:MapEditorLabeled">
                  <TextBlock Text="{Binding Label}" Classes="caption" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <local:OrnamentDivider Classes="section" />
            <Button Classes="pill" HorizontalAlignment="Center" Padding="16,0" Height="30" Content="{local:Text 'Swap sides'}" Command="{Binding SwapSidesCommand}" />
          </StackPanel>
        </ContentControl>

        <ContentControl Grid.Column="2" Content="{Binding Defender}" ContentTemplate="{StaticResource SandboxSideTemplate}" VerticalAlignment="Top" />
      </Grid>

      <StackPanel Grid.Row="2" Margin="0,10,0,0" Spacing="6">
        <local:MapEditorUnitLevelBar />
        <TextBlock Text="{Binding Problem}"
                   Classes="body"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="1000"
                   Foreground="{StaticResource AccentBrush}"
                   IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Button Classes="pill" HorizontalAlignment="Center" MinWidth="140" Content="{local:Text 'Back'}" Command="{Binding CloseCommand}" />
      </StackPanel>
    </Grid>

    <ItemsControl Classes="drop-zones" ItemsSource="{Binding DropZones}" Margin="0,12,0,0" />
  </Grid>

</UserControl>
