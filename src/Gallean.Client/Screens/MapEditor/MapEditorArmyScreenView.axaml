<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Gallean.Client"
             x:Class="Gallean.Client.MapEditorArmyScreenView"
             x:DataType="local:MapEditorArmyScreenViewModel">

  <UserControl.Styles>
    <Style Selector="Border.rune.purchase">
      <Setter Property="ToolTip.Tip" Value="{local:Text 'Add a unit'}" />
    </Style>
    <Style Selector="Line.party-divider">
      <Setter Property="Margin" Value="32,24,32,0" />
      <Setter Property="Stretch" Value="Fill" />
      <Setter Property="StartPoint" Value="0,0" />
      <Setter Property="EndPoint" Value="0,1" />
      <Setter Property="Stroke" Value="{StaticResource AccentSecondaryBrush}" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="StrokeDashArray" Value="4,3" />
    </Style>
  </UserControl.Styles>

  <Grid Background="{StaticResource ModalBackdropBrush}" local:Backdrop.CloseCommand="{Binding CloseCommand}">
    <ContentControl Classes="ornament-panel"
                    Background="{StaticResource CapitalScenePanelBodyGradientBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
      <Grid RowDefinitions="Auto,*,Auto" Margin="28,16">
        <local:OutlinedTextBlock Grid.Row="0" Text="{Binding Title}" Classes="object-name title" HorizontalAlignment="Center" Margin="0,0,0,8" />

        <Grid Grid.Row="1" ColumnDefinitions="320,Auto,Auto">
          <!-- Leader -->
          <Panel Grid.Column="0" Width="320" Height="470">
            <Grid RowDefinitions="*,Auto" IsVisible="{Binding Army.HasLeader}">
              <Viewbox Grid.Row="0" StretchDirection="DownOnly" ClipToBounds="False">
                <Panel Width="300" Height="430" Background="Transparent" DataContext="{Binding Army.Leader}">
                  <Ellipse Width="420"
                           Height="420"
                           Margin="-60,-30"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Fill="{StaticResource StackPortraitGlowGradientBrush}" />
                  <local:PointerTiltDecorator Classes="event-portrait" Margin="-20,0,-20,0" x:DataType="local:StackLeaderViewModel">
                    <local:SpriteVisual SpriteKey="{Binding PortraitKey}" Stretch="Uniform" />
                  </local:PointerTiltDecorator>
                </Panel>
              </Viewbox>
              <StackPanel Grid.Row="1" Spacing="4" Margin="0,-16,0,0" HorizontalAlignment="Center">
                <local:OutlinedTextBlock Text="{Binding Army.Leader.Title}"
                                         Classes="object-name title"
                                         HorizontalAlignment="Center"
                                         TextTrimming="CharacterEllipsis" />
                <ItemsControl Width="300" Margin="0,6,0,0" Classes="stat-table" ItemsSource="{Binding Army.Leader.Stats}" />
                <Button x:Name="ChangeLeaderButton"
                        Content="{local:Text 'Change leader'}"
                        Classes="pill"
                        local:PlateChrome.TextureSeed="3"
                        Command="{Binding ChooseLeaderCommand}"
                        HorizontalAlignment="Center"
                        Height="28"
                        Padding="14,0"
                        Margin="0,8,0,0"
                        FontSize="{StaticResource FontSizeSm}" />
              </StackPanel>
            </Grid>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsVisible="{Binding !Army.HasLeader}">
              <local:IconVisual Moniker="Stack"
                                Width="36"
                                Height="36"
                                HorizontalAlignment="Center"
                                Foreground="{StaticResource SecondaryTextBrush}" />
              <TextBlock Text="{local:Text 'Every army needs a leader.'}"
                         Classes="prose"
                         FontSize="{StaticResource FontSizeSm}"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         TextAlignment="Center" />
              <Button x:Name="ChooseLeaderButton"
                      Content="{local:Text 'Choose leader'}"
                      Classes="pill"
                      local:PlateChrome.TextureSeed="3"
                      Command="{Binding ChooseLeaderCommand}"
                      HorizontalAlignment="Center"
                      Height="28"
                      Padding="14,0"
                      FontSize="{StaticResource FontSizeSm}" />
            </StackPanel>
          </Panel>

          <Line Grid.Column="1" Classes="party-divider" />

          <!-- Party -->
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,0,0,12" ToolTip.Tip="{local:Text 'Leadership'}">
              <local:OutlinedTextBlock Text="{local:Text 'Party'}" Classes="object-name row" />
              <local:OutlinedTextBlock Text="{Binding Army.CapacityText}" Classes="object-name row" Foreground="{StaticResource SecondaryTextBrush}" />
              <local:IconVisual Moniker="Leadership" Width="18" Height="18" Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
            <Viewbox Classes="unit-grid-container" HorizontalAlignment="Center" VerticalAlignment="Top">
              <ItemsControl x:Name="PartyGrid"
                            Classes="unit-grid focus-group"
                            ItemsSource="{Binding UnitGrid.Slots}"
                            ItemTemplate="{StaticResource UnitGridSlotTemplate}"
                            ItemContainerTheme="{StaticResource UnitGridSlotContainerTheme}" />
            </Viewbox>
            <TextBlock Text="{local:Text 'Click + to add a unit. Drag units to rearrange them, or onto Remove. Right-click a unit for details.'}"
                       Classes="caption"
                       Width="240"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Margin="0,12,0,0" />
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="10">
          <local:MapEditorUnitLevelBar />
          <TextBlock Text="{Binding Problem}"
                     Classes="body"
                     HorizontalAlignment="Center"
                     Foreground="{StaticResource AccentBrush}"
                     IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <StackPanel Classes="focus-group" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
            <Button x:Name="DeleteButton"
                    Classes="pill"
                    local:PlateChrome.TextureSeed="4"
                    MinWidth="140"
                    Content="{local:Text 'Delete army'}"
                    Command="{Binding DeleteCommand}"
                    IsVisible="{Binding CanDelete}" />
            <Button x:Name="CancelButton"
                    Classes="pill"
                    local:PlateChrome.TextureSeed="5"
                    MinWidth="140"
                    Content="{local:Text 'Cancel'}"
                    Command="{Binding CloseCommand}" />
            <Button x:Name="ConfirmButton"
                    Classes="pill primary"
                    local:PlateChrome.TextureSeed="6"
                    MinWidth="140"
                    Content="{Binding ConfirmLabel}"
                    Command="{Binding ConfirmCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </ContentControl>

    <ItemsControl Classes="drop-zones" ItemsSource="{Binding DropZones}" Margin="0,12,0,0" />
  </Grid>

</UserControl>
