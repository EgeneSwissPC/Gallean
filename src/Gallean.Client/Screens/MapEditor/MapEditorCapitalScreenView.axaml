<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Gallean.Client"
             x:Class="Gallean.Client.MapEditorCapitalScreenView"
             x:DataType="local:MapEditorCapitalScreenViewModel">

  <UserControl.Styles>
    <Style Selector="Border.rune.purchase">
      <Setter Property="ToolTip.Tip" Value="{local:Text 'Add a unit'}" />
    </Style>
    <Style Selector="Line.party-divider">
      <Setter Property="Margin" Value="24,24,24,0" />
      <Setter Property="Stretch" Value="Fill" />
      <Setter Property="StartPoint" Value="0,0" />
      <Setter Property="EndPoint" Value="0,1" />
      <Setter Property="Stroke" Value="{StaticResource AccentSecondaryBrush}" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="StrokeDashArray" Value="4,3" />
    </Style>
    <Style Selector=":is(TextBlock).field-label">
      <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
  </UserControl.Styles>

  <Grid Background="{StaticResource ModalBackdropBrush}" local:Backdrop.CloseCommand="{Binding CloseCommand}">
    <ContentControl Classes="ornament-panel"
                    Background="{StaticResource CapitalScenePanelBodyGradientBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
      <Grid RowDefinitions="Auto,*,Auto" Margin="28,16">
        <local:OutlinedTextBlock Grid.Row="0" Text="{Binding Title}" Classes="object-name title" HorizontalAlignment="Center" Margin="0,0,0,8" />

        <Grid Grid.Row="1" ColumnDefinitions="260,Auto,Auto,Auto,Auto">
          <!-- Capital -->
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <Panel Height="190">
              <local:SpriteVisual SpriteKey="{Binding ImageKey}" Stretch="Uniform" />
            </Panel>
            <TextBlock Text="{local:Text 'For a human player, the leader is replaced by the one chosen when the game starts; the rest of the army stays.'}"
                       Classes="caption"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Margin="0,12,0,0" />
          </StackPanel>

          <Line Grid.Column="1" Classes="party-divider" />

          <!-- Garrison -->
          <StackPanel Grid.Column="2" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,0,0,12" ToolTip.Tip="{local:Text 'Garrison size'}">
              <local:OutlinedTextBlock Text="{local:Text 'Garrison'}" Classes="object-name row" />
              <local:OutlinedTextBlock Text="{Binding Garrison.CapacityText}" Classes="object-name row" Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
            <Viewbox Classes="unit-grid-container" HorizontalAlignment="Center" VerticalAlignment="Top">
              <ItemsControl x:Name="GarrisonGrid"
                            Classes="unit-grid focus-group"
                            ItemsSource="{Binding Garrison.UnitGrid.Slots}"
                            ItemTemplate="{StaticResource UnitGridSlotTemplate}"
                            ItemContainerTheme="{StaticResource UnitGridSlotContainerTheme}" />
            </Viewbox>
            <TextBlock Text="{local:Text 'Defenders of the capital: the guardian always stays; 6 places in all, large units count twice.'}"
                       Classes="caption"
                       Width="240"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Margin="0,12,0,0" />
          </StackPanel>

          <Line Grid.Column="3" Classes="party-divider" />

          <!-- Stationed army -->
          <StackPanel Grid.Column="4" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,0,0,12" ToolTip.Tip="{local:Text 'Leadership'}">
              <local:OutlinedTextBlock Text="{local:Text 'Stationed army'}" Classes="object-name row" />
              <local:OutlinedTextBlock Text="{Binding Army.CapacityText}" Classes="object-name row" Foreground="{StaticResource SecondaryTextBrush}" IsVisible="{Binding Army.HasLeader}" />
            </StackPanel>
            <Viewbox Classes="unit-grid-container" HorizontalAlignment="Center" VerticalAlignment="Top">
              <ItemsControl x:Name="ArmyGrid"
                            Classes="unit-grid focus-group"
                            ItemsSource="{Binding Army.UnitGrid.Slots}"
                            ItemTemplate="{StaticResource UnitGridSlotTemplate}"
                            ItemContainerTheme="{StaticResource UnitGridSlotContainerTheme}" />
            </Viewbox>
            <TextBlock Text="{Binding Army.Leader.Title}"
                       Classes="body"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       IsVisible="{Binding Army.HasLeader}"
                       Margin="0,10,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
              <Button x:Name="ArmyLeaderButton"
                      Classes="pill"
                      Height="28"
                      Padding="14,0"
                      FontSize="{StaticResource FontSizeSm}"
                      Content="{local:Text 'Change leader'}"
                      Command="{Binding ChooseArmyLeaderCommand}" />
            </StackPanel>
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="10">
          <local:MapEditorUnitLevelBar />
          <TextBlock Text="{Binding Problem}"
                     Classes="body"
                     HorizontalAlignment="Center"
                     Foreground="{StaticResource AccentBrush}"
                     IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <StackPanel Classes="focus-group" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
            <Button x:Name="CancelButton"
                    Classes="pill"
                    local:PlateChrome.TextureSeed="5"
                    MinWidth="140"
                    Content="{local:Text 'Cancel'}"
                    Command="{Binding CloseCommand}" />
            <Button x:Name="ConfirmButton"
                    Classes="pill primary"
                    local:PlateChrome.TextureSeed="6"
                    MinWidth="140"
                    Content="{local:Text 'Save capital'}"
                    Command="{Binding ConfirmCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </ContentControl>

    <ItemsControl Classes="drop-zones" ItemsSource="{Binding DropZones}" Margin="0,12,0,0" />
  </Grid>

</UserControl>
