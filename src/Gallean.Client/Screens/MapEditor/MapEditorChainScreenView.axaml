<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Gallean.Client"
             x:Class="Gallean.Client.MapEditorChainScreenView"
             x:DataType="local:MapEditorChainScreenViewModel">

  <UserControl.Styles>
    <Style Selector="Line.on, Line.head.on">
      <Setter Property="Stroke" Value="#5FC46A" />
    </Style>
    <Style Selector="Line.off">
      <Setter Property="Stroke" Value="#E0604E" />
      <Setter Property="StrokeDashArray" Value="5,3" />
    </Style>
    <Style Selector="Border.node">
      <Setter Property="Width" Value="230" />
      <Setter Property="Height" Value="50" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Background" Value="#3A4A6B" />
      <Setter Property="BorderBrush" Value="#60000000" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border.node.never">
      <Setter Property="Background" Value="#7A4A1E" />
      <Setter Property="BorderBrush" Value="#E0A040" />
    </Style>
  </UserControl.Styles>

  <Grid Background="{StaticResource ModalBackdropBrush}" local:Backdrop.CloseCommand="{Binding CloseCommand}">
    <ContentControl Classes="ornament-panel"
                    Background="{StaticResource CapitalScenePanelBodyGradientBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
      <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20,12" Width="1200" Height="640">
        <local:OutlinedTextBlock Grid.Row="0" Text="{local:Text 'Event chains'}" Classes="object-name title" HorizontalAlignment="Center" />
        <TextBlock Grid.Row="1" Margin="0,4,0,8" Classes="caption" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Summary}" />

        <Panel Grid.Row="2">
          <TextBlock Text="{local:Text 'No events yet.'}" Classes="caption" Foreground="{StaticResource SecondaryTextBrush}" IsVisible="{Binding HasNoEvents}" />
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Panel x:Name="ChainCanvas" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" HorizontalAlignment="Left" VerticalAlignment="Top">
              <ItemsControl ItemsSource="{Binding Links}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Panel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:MapEditorChainLinkViewModel">
                    <Panel>
                      <Line StartPoint="{Binding From}" EndPoint="{Binding To}" StrokeThickness="2" Classes.on="{Binding On}" Classes.off="{Binding Off}" />
                      <Line StartPoint="{Binding To}" EndPoint="{Binding HeadA}" StrokeThickness="2" Classes.on="{Binding On}" Classes.off="{Binding Off}" />
                      <Line StartPoint="{Binding To}" EndPoint="{Binding HeadB}" StrokeThickness="2" Classes.on="{Binding On}" Classes.off="{Binding Off}" />
                      <TextBlock Text="{Binding Label}" Classes="caption" Margin="{Binding LabelMargin}" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{StaticResource SecondaryTextBrush}" />
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Nodes}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Panel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:MapEditorChainNodeViewModel">
                    <Border Classes="node" Classes.never="{Binding NeverFires}" Margin="{Binding Margin}" Tapped="OnNodeTapped" ToolTip.Tip="{local:Text 'Click to open the event'}">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" Classes="body" Foreground="#F2EAD8" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding State}" Classes="caption" Foreground="#D8CFBC" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>
          </ScrollViewer>
        </Panel>

        <Button Grid.Row="3" x:Name="CloseButton" Classes="pill" Margin="0,10,0,0" MinWidth="140" HorizontalAlignment="Center" Content="{local:Text 'Close'}" Command="{Binding CloseCommand}" />
      </Grid>
    </ContentControl>
  </Grid>

</UserControl>
