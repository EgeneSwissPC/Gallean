<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Gallean.Client"
             xmlns:texts="clr-namespace:Gallean.Client.Texts;assembly=Gallean.Client.Texts"
             x:Class="Gallean.Client.MapEditorScreenView"
             x:DataType="local:MapEditorScreenViewModel">

  <!-- Copied from WorldScreenView: used by the right-click info templates below. -->
  <UserControl.Resources>
    <ControlTheme x:Key="UnitGroupInfoUnitContainerTheme" TargetType="ContentPresenter" x:DataType="local:WorldUnitGroupInfoUnitViewModel">
      <Setter Property="Grid.Row" Value="{Binding Row}" />
      <Setter Property="Grid.Column" Value="{Binding Column}" />
      <Setter Property="Grid.ColumnSpan" Value="{Binding ColumnSpan}" />
    </ControlTheme>

    <DataTemplate x:Key="UnitGroupInfoUnitTemplate" x:DataType="local:WorldUnitGroupInfoUnitViewModel">
      <local:UnitPortrait FaceKey="{Binding FaceKey}"
                          Hitpoints="{Binding Hitpoints}"
                          MaxHitpoints="{Binding MaxHitpoints}"
                          IsDead="{Binding !IsAlive}"
                          Statuses="{Binding Statuses}"
                          StatusTemplate="{StaticResource UnitStatusBadgeTemplate}">
        <local:OutlinedTextBlock Classes="object-name compact unit-group-info-name" Text="{Binding Name}" />
      </local:UnitPortrait>
    </DataTemplate>

    <DataTemplate x:Key="UnitGroupInfoGridTemplate" x:DataType="local:WorldUnitGroupInfoGridViewModel">
      <Grid Width="230" Height="414" local:PortraitScope.IsFacingLeft="{Binding IsFacingLeft}">
        <UniformGrid Rows="3" Columns="2">
          <local:UnitPortrait />
          <local:UnitPortrait />
          <local:UnitPortrait />
          <local:UnitPortrait />
          <local:UnitPortrait />
          <local:UnitPortrait />
        </UniformGrid>
        <ItemsControl ItemsSource="{Binding Units}"
                      ClipToBounds="False"
                      ItemContainerTheme="{StaticResource UnitGroupInfoUnitContainerTheme}"
                      ItemTemplate="{StaticResource UnitGroupInfoUnitTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Grid RowDefinitions="*,*,*" ColumnDefinitions="*,*" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="UnitGroupInfoLineTemplate" x:DataType="texts:TextSpans">
      <local:OutlinedTextBlock local:TextRuns.Spans="{Binding}"
                               Classes="body"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap" />
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <StyleInclude Source="avares://Gallean.Client/Screens/World/WorldChrome.axaml" />
    <Style Selector="local|OutlinedTextBlock.unit-group-info-name">
      <Setter Property="Margin" Value="4,0,4,20" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector=":is(TextBlock).unit-group-info-header">
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector=":is(TextBlock).field-label">
      <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
    <Style Selector="ListBox.tools > ListBoxItem">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.palette > ListBoxItem">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="2" />
    </Style>
    <Style Selector="Border.editor-panel">
      <Setter Property="Background" Value="{StaticResource ModalBackdropBrush}" />
      <Setter Property="Width" Value="340" />
      <Setter Property="Padding" Value="20,16" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,Auto" Background="Black">
    <local:MapEditorVisual x:Name="Map" Grid.Column="0" />

    <local:OutlinedTextBlock Grid.Column="0"
                             Text="{Binding HoverText}"
                             Classes="caption"
                             Foreground="{StaticResource PrimaryTextBrush}"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Bottom"
                             Margin="12,8"
                             IsHitTestVisible="False" />

    <!-- Right-click info: the same templates as the world screen's position info popup. -->
    <Popup x:Name="PositionInfoPopup"
           Grid.Column="0"
           IsOpen="{Binding PositionInfo, Converter={x:Static ObjectConverters.IsNotNull}}"
           PlacementTarget="{Binding #Map}"
           Placement="AnchorAndGravity"
           PlacementAnchor="Right"
           PlacementGravity="Right"
           PlacementConstraintAdjustment="FlipX,SlideX,SlideY"
           IsHitTestVisible="False">
      <ContentControl Classes="cached" Content="{Binding PositionInfo}">
        <ContentControl.DataTemplates>
          <DataTemplate x:DataType="local:WorldStackInfoViewModel">
            <local:ModalFrameDecorator Padding="16" Margin="0,40,0,0">
              <Grid ColumnDefinitions="260,Auto" ColumnSpacing="16">
                <DockPanel Grid.Column="0">
                  <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,12,0,0">
                    <local:OutlinedTextBlock Text="{Binding LeaderName}"
                                             Classes="object-name row"
                                             HorizontalAlignment="Center"
                                             TextTrimming="CharacterEllipsis" />
                    <local:OutlinedTextBlock Text="{Binding RaceName}"
                                             Classes="body"
                                             Foreground="{StaticResource SecondaryTextBrush}"
                                             HorizontalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource UnitGroupInfoLineTemplate}" />
                  </StackPanel>
                  <local:PointerTiltDecorator Classes="event-portrait" Margin="-24,-56,-24,-20">
                    <local:SpriteVisual SpriteKey="{Binding LeaderPortraitKey}" Stretch="Uniform" />
                  </local:PointerTiltDecorator>
                </DockPanel>
                <Panel Grid.Column="1">
                  <ContentControl Content="{Binding Grid}"
                                  ContentTemplate="{StaticResource UnitGroupInfoGridTemplate}"
                                  ClipToBounds="False"
                                  IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNull}}" />
                  <local:OutlinedTextBlock Text="{Binding Note}"
                                           IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}"
                                           Classes="body"
                                           Width="230"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center" />
                </Panel>
              </Grid>
            </local:ModalFrameDecorator>
          </DataTemplate>
          <DataTemplate x:DataType="local:WorldFortificationInfoViewModel">
            <local:ModalFrameDecorator Padding="16,12,16,16">
              <StackPanel Spacing="8">
                <local:OutlinedTextBlock Text="{Binding Title}"
                                         Classes="h4"
                                         Foreground="{StaticResource PrimaryTextBrush}"
                                         HorizontalAlignment="Center" />
                <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource UnitGroupInfoLineTemplate}" />
                <Rectangle Classes="details-rule" />
                <local:OutlinedTextBlock Text="{Binding Note}"
                                         IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}"
                                         Classes="body"
                                         MaxWidth="476"
                                         Foreground="{StaticResource PrimaryTextBrush}"
                                         TextWrapping="Wrap"
                                         TextAlignment="Center" />
                <Grid ColumnDefinitions="Auto,Auto"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="16"
                      RowSpacing="4"
                      IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNull}}">
                  <local:OutlinedTextBlock Grid.Column="0"
                                           Grid.Row="0"
                                           Text="{Binding VisitingStackTitle}"
                                           Classes="body unit-group-info-header"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                  <local:OutlinedTextBlock Grid.Column="1"
                                           Grid.Row="0"
                                           Text="{local:Text 'City defenses'}"
                                           Classes="body unit-group-info-header"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           HorizontalAlignment="Center" />
                  <ContentControl Grid.Column="0"
                                  Grid.Row="1"
                                  Content="{Binding VisitingStack}"
                                  ContentTemplate="{StaticResource UnitGroupInfoGridTemplate}"
                                  ClipToBounds="False" />
                  <ContentControl Grid.Column="1"
                                  Grid.Row="1"
                                  Content="{Binding Defenses}"
                                  ContentTemplate="{StaticResource UnitGroupInfoGridTemplate}"
                                  ClipToBounds="False" />
                </Grid>
              </StackPanel>
            </local:ModalFrameDecorator>
          </DataTemplate>
          <DataTemplate x:DataType="local:WorldTileInfoViewModel">
            <local:ModalFrameDecorator Width="300" Padding="20,16">
              <StackPanel Spacing="8">
                <local:OutlinedTextBlock Text="{Binding Title}"
                                         Classes="h4"
                                         Foreground="{StaticResource PrimaryTextBrush}"
                                         HorizontalAlignment="Center"
                                         TextAlignment="Center"
                                         TextWrapping="Wrap" />
                <Rectangle Classes="details-rule" IsVisible="{Binding HasDetails}" />
                <ItemsControl ItemsSource="{Binding Lines}"
                              ItemTemplate="{StaticResource UnitGroupInfoLineTemplate}"
                              IsVisible="{Binding Lines.Count, Converter={x:Static local:GreaterThanConverter.Instance}, ConverterParameter=0}" />
                <ItemsControl ItemsSource="{Binding Tombs}"
                              IsVisible="{Binding Tombs.Count, Converter={x:Static local:GreaterThanConverter.Instance}, ConverterParameter=0}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="texts:TextSpans">
                      <local:OutlinedTextBlock Classes="body"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               local:TextRuns.Spans="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ContentControl Content="{Binding Garrison}"
                                ContentTemplate="{StaticResource UnitGroupInfoGridTemplate}"
                                IsVisible="{Binding Garrison, Converter={x:Static ObjectConverters.IsNotNull}}"
                                HorizontalAlignment="Center"
                                ClipToBounds="False" />
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="12"
                      IsVisible="{Binding Item, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <Panel Grid.Column="0" Classes="inventory-slot">
                    <local:PlateChrome Classes="socket" />
                    <local:SpriteVisual SpriteKey="{Binding Item.SpriteKey, FallbackValue={x:Null}}" Stretch="Uniform" />
                  </Panel>
                  <local:OutlinedTextBlock Grid.Column="1"
                                           Text="{Binding Item.Name, FallbackValue=''}"
                                           Classes="object-name row"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                </Grid>
                <ContentControl Content="{Binding Reward}"
                                Classes="body"
                                IsVisible="{Binding Reward, Converter={x:Static ObjectConverters.IsNotNull}}"
                                HorizontalAlignment="Center"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                <StackPanel Orientation="Horizontal"
                            Spacing="6"
                            IsVisible="{Binding Income, Converter={x:Static ObjectConverters.IsNotNull}}"
                            HorizontalAlignment="Center">
                  <local:OutlinedTextBlock Text="{local:Text 'Income:'}"
                                           Classes="body"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" />
                  <ContentControl Content="{Binding Income}"
                                  Classes="body"
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource PrimaryTextBrush}" />
                </StackPanel>
              </StackPanel>
            </local:ModalFrameDecorator>
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Popup>

    <!-- The landmark palette sits over the left of the map, so it gets the full height at any window size. -->
    <Border Grid.Column="0"
            Classes="editor-panel"
            HorizontalAlignment="Left"
            Margin="0,0,0,40"
            IsVisible="{Binding ShowLandmarkPalette}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <local:OutlinedTextBlock Text="{local:Text 'Landmarks'}" Classes="h4" Foreground="{StaticResource ScenarioSelectAccentBrush}" />
          <Grid ColumnDefinitions="*,8,*" Margin="0,10,0,8">
            <ComboBox x:Name="LandmarkCategoryBox" Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding LandmarkCategories}" SelectedItem="{Binding SelectedLandmarkCategory}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="local:MapEditorLabeled">
                  <TextBlock Text="{Binding Label}" Classes="body" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox x:Name="LandmarkSizeBox" Grid.Column="2" HorizontalAlignment="Stretch" ItemsSource="{Binding LandmarkSizes}" SelectedItem="{Binding SelectedLandmarkSize}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="local:MapEditorLabeled">
                  <TextBlock Text="{Binding Label}" Classes="body" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
        </StackPanel>
        <ListBox x:Name="LandmarkPalette"
                 Classes="palette"
                 ItemsSource="{Binding Landmarks}"
                 SelectedItem="{Binding SelectedLandmark}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:MapEditorLandmarkOption">
              <local:AnimationVisual AnimationKey="{Binding PreviewKey}"
                                     Width="68"
                                     Height="68"
                                     Stretch="Uniform"
                                     ToolTip.Tip="{Binding Caption}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- The economy panel (E), over the left of the map like the landmark palette; laid out like the game's
         "Income per turn" table. Selecting a race outlines its resources and rods on the map. -->
    <Border Grid.Column="0"
            Classes="editor-panel"
            Width="430"
            HorizontalAlignment="Left"
            Margin="0,0,0,40"
            IsVisible="{Binding IsEconomyOpen}">
      <DockPanel Grid.IsSharedSizeScope="True">
        <StackPanel DockPanel.Dock="Top" Spacing="4">
          <local:OutlinedTextBlock Text="{local:Text 'Economy'}" Classes="h4" Foreground="{StaticResource ScenarioSelectAccentBrush}" />
          <TextBlock Text="{local:Text 'Income per turn at Average difficulty, as the game counts it. A resource pays the race whose land it stands on. Click a race to outline its resources and rods on the map.'}"
                     Classes="caption"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource SecondaryTextBrush}" />
          <!-- The land spread preview: like the unit level bar, steps the land forward by turns. -->
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button x:Name="SpreadDownTenButton" Classes="pill" Height="28" Padding="10,0" Content="-10" Command="{Binding SpreadDownTenCommand}" />
            <Button x:Name="SpreadDownButton" Classes="pill" Width="28" Height="28" Padding="0" Content="-" Command="{Binding SpreadDownCommand}" />
            <TextBlock Text="{Binding SpreadTurnText}"
                       Classes="body"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       MinWidth="120" />
            <Button x:Name="SpreadUpButton" Classes="pill" Width="28" Height="28" Padding="0" Content="+" Command="{Binding SpreadUpCommand}" />
            <Button x:Name="SpreadUpTenButton" Classes="pill" Height="28" Padding="10,0" Content="+10" Command="{Binding SpreadUpTenCommand}" />
          </StackPanel>
          <Button x:Name="BackToMapButton" Classes="pill" Height="28" HorizontalAlignment="Center" Padding="12,0" Content="{local:Text 'Back to the map'}" Command="{Binding BackToMapCommand}" IsVisible="{Binding IsSpreadPreview}" />
          <TextBlock Text="{local:Text 'Land spread preview: capitals, villages and rods grow their land every turn as in the game, with nobody moving or fighting. Nothing is edited while a later turn is shown.'}"
                     Classes="caption"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource SecondaryTextBrush}" />
          <Grid Margin="16,8,14,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="EconomyCount" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="IncomeCapital" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="IncomeNodes" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="IncomeTotal" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Classes="income-cell caption" Text="{local:Text 'Count'}" Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBlock Grid.Column="2" Classes="income-cell caption" Text="{local:Text 'Capital'}" Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBlock Grid.Column="3" Classes="income-cell caption" Text="{local:Text 'Sources'}" Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBlock Grid.Column="4" Classes="income-cell caption" Text="{local:Text 'Total'}" Foreground="{StaticResource SecondaryTextBrush}" />
          </Grid>
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
          <StackPanel Spacing="10">
            <ListBox x:Name="EconomyRaceList"
                     Classes="select-list"
                     ItemsSource="{Binding EconomyRaces}"
                     SelectedItem="{Binding SelectedEconomyRace}"
                     SelectionMode="Single,Toggle"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:MapEditorEconomyRaceViewModel">
                  <Border Classes="row">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Title}" Classes="body row-title" />
                    <TextBlock Text="{Binding Summary}" Classes="caption" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding StartText}" Classes="caption" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="2" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:MapEditorEconomyRowViewModel">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" SharedSizeGroup="EconomyCount" />
                              <ColumnDefinition Width="Auto" SharedSizeGroup="IncomeCapital" />
                              <ColumnDefinition Width="Auto" SharedSizeGroup="IncomeNodes" />
                              <ColumnDefinition Width="Auto" SharedSizeGroup="IncomeTotal" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                              <local:IconVisual Moniker="{Binding Income.Icon}" Width="18" Height="18" VerticalAlignment="Center" />
                              <TextBlock Classes="body" Text="{Binding Income.Name}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Classes="income-cell body" Text="{Binding CountText}" />
                            <TextBlock Grid.Column="2" Classes="income-cell body" Text="{Binding Income.CapitalIncomeText}" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="3" Classes="income-cell body" Text="{Binding Income.ResourceNodesIncomeText}" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="4" Classes="income-cell body" Text="{Binding Income.IncomeText}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Spacing="4" Margin="16,0,14,0">
              <local:OutlinedTextBlock Text="{local:Text 'Unowned land'}" Classes="body" Foreground="{StaticResource PrimaryTextBrush}" />
              <TextBlock Text="{local:Text 'No resource stands on unowned land.'}"
                         Classes="caption"
                         IsVisible="{Binding !HasUnclaimed}"
                         Foreground="{StaticResource SecondaryTextBrush}" />
              <ItemsControl ItemsSource="{Binding UnclaimedResources}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:MapEditorEconomyRowViewModel">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="EconomyCount" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="IncomeCapital" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="IncomeNodes" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="IncomeTotal" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                        <local:IconVisual Moniker="{Binding Income.Icon}" Width="18" Height="18" VerticalAlignment="Center" />
                        <TextBlock Classes="body" Text="{Binding Income.Name}" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Classes="income-cell body" Text="{Binding CountText}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Spacing="6" Margin="16,6,14,0">
              <local:OutlinedTextBlock Text="{local:Text 'Starting bank'}" Classes="body" Foreground="{StaticResource PrimaryTextBrush}" />
              <ComboBox x:Name="BankRaceBox" HorizontalAlignment="Stretch" ItemsSource="{Binding BankRaces}" SelectedItem="{Binding SelectedBankRace}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:MapEditorLabeled">
                    <TextBlock Text="{Binding Label}" Classes="body" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <ItemsControl ItemsSource="{Binding BankFields}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:MapEditorBankFieldViewModel">
                    <Grid ColumnDefinitions="Auto,*,54" Margin="0,2,6,2">
                      <local:IconVisual Grid.Column="0" Moniker="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Center" ToolTip.Tip="{Binding Name}" />
                      <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Name}" VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis" />
                      <TextBox Grid.Column="2" Text="{Binding Text}" MaxLength="4" HorizontalContentAlignment="Right" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button x:Name="CopyBankButton" Classes="pill" local:PlateChrome.TextureSeed="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{local:Text 'Same for all races'}" Command="{Binding CopyBankToAllCommand}" />
              <TextBlock Text="{local:Text 'The race own mana goes to each race own mana. In the game a human player gets 300% of it on Easy, 50% on Hard and 25% on Very hard; computer players get it as set.'}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- The locations list (L), over the left of the map like the economy panel: sorted by name, with a search box.
         Names are edited in the row (double-click, or right after placing); hovering a row lights its square up. -->
    <Border Grid.Column="0"
            Classes="editor-panel"
            Width="340"
            HorizontalAlignment="Left"
            Margin="0,0,0,60"
            IsVisible="{Binding IsLocationsOpen}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="6">
          <local:OutlinedTextBlock x:Name="LocationsTitle" Text="{Binding LocationsTitle}" Classes="h4" Foreground="{StaticResource ScenarioSelectAccentBrush}" />
          <TextBlock Text="{local:Text 'Named zones for events and army orders; the game does not show them. Click a row to go there, double-click to rename.'}"
                     Classes="caption"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource SecondaryTextBrush}" />
          <TextBox x:Name="LocationSearchBox" Text="{Binding LocationSearch}" Watermark="{local:Text 'Search'}" IsVisible="{Binding HasLocations}" />
        </StackPanel>
        <Panel Margin="0,6,0,0">
          <TextBlock Text="{local:Text 'No locations. Pick the Locations tool and click the map.'}"
                     Classes="caption"
                     TextWrapping="Wrap"
                     IsVisible="{Binding HasNoLocationRows}"
                     Foreground="{StaticResource SecondaryTextBrush}" />
          <ListBox x:Name="LocationList"
                   Classes="select-list"
                   ItemsSource="{Binding LocationRows}"
                   SelectedItem="{Binding SelectedLocationRow}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:MapEditorLocationRowViewModel">
                <Border Classes="row"
                        Background="Transparent"
                        PointerEntered="OnLocationRowPointerEntered"
                        PointerExited="OnLocationRowPointerExited"
                        DoubleTapped="OnLocationRowDoubleTapped">
                  <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Classes="pill"
                            Width="28"
                            Height="28"
                            Padding="0"
                            VerticalAlignment="Center"
                            Content="×"
                            ToolTip.Tip="{local:Text 'Delete'}"
                            Command="{Binding DeleteCommand}" />
                    <StackPanel Spacing="2" Margin="0,0,8,0">
                      <TextBlock Text="{Binding Name}" Classes="body row-title" TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsEditing}" />
                      <TextBox Text="{Binding EditText}"
                               MaxLength="60"
                               IsVisible="{Binding IsEditing}"
                               KeyDown="OnLocationNameKeyDown"
                               LostFocus="OnLocationNameLostFocus"
                               PropertyChanged="OnLocationNameBoxPropertyChanged" />
                      <TextBlock Text="{Binding Details}" Classes="caption" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Panel>
      </DockPanel>
    </Border>

    <!-- The events list (V), over the left of the map like the locations list. A row: name (red mark when the event
         can't be saved yet), races and size, "on at start" box; double-click opens the block editor. -->
    <Border Grid.Column="0"
            Classes="editor-panel"
            Width="360"
            HorizontalAlignment="Left"
            Margin="0,0,0,60"
            IsVisible="{Binding ShowEventsList}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="6">
          <DockPanel>
            <Button x:Name="NewEventButton" DockPanel.Dock="Right" Classes="pill" Height="28" Padding="10,0" Content="{local:Text 'New event'}" Command="{Binding NewEventCommand}" />
            <Button x:Name="TemplatesButton" DockPanel.Dock="Right" Classes="pill" Height="28" Padding="10,0" Margin="0,0,6,0" Content="{local:Text 'Armies'}" ToolTip.Tip="{local:Text 'Army templates: armies that events create'}" Command="{Binding OpenTemplatesCommand}" />
            <local:OutlinedTextBlock x:Name="EventsTitle" Text="{Binding EventsTitle}" Classes="h4" Foreground="{StaticResource ScenarioSelectAccentBrush}" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Text="{local:Text 'The map script: when something happens, do something. Double-click an event to edit its blocks.'}"
                     Classes="caption"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource SecondaryTextBrush}" />
          <DockPanel>
            <Button x:Name="AddRecipeButton" DockPanel.Dock="Right" Classes="pill" Height="28" Padding="10,0" Margin="6,0,0,0" Content="{local:Text 'Add'}" Command="{Binding AddRecipeCommand}" />
            <ComboBox x:Name="RecipeBox" HorizontalAlignment="Stretch" ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}" PlaceholderText="{local:Text 'Recipes: ready-made events'}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="local:MapEditorLabeled">
                  <TextBlock Text="{Binding Label}" Classes="body" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </DockPanel>
          <TextBlock Text="{Binding RecipeDescription}" Classes="caption" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
          <TextBox x:Name="EventSearchBox" Text="{Binding EventSearch}" Watermark="{local:Text 'Search'}" IsVisible="{Binding HasEvents}" />
        </StackPanel>
        <Panel Margin="0,6,0,0">
          <TextBlock Text="{local:Text 'No events yet. Click New event to build one from blocks.'}"
                     Classes="caption"
                     TextWrapping="Wrap"
                     IsVisible="{Binding HasNoEventRows}"
                     Foreground="{StaticResource SecondaryTextBrush}" />
          <ListBox x:Name="EventList"
                   Classes="select-list"
                   ItemsSource="{Binding EventRows}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:MapEditorEventRowViewModel">
                <Border Classes="row" Background="Transparent" DoubleTapped="OnEventRowDoubleTapped">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                      <CheckBox IsChecked="{Binding IsEnabled}" ToolTip.Tip="{local:Text 'On at the start'}" />
                      <Button Classes="pill" Width="28" Height="28" Padding="0" Content="×" ToolTip.Tip="{local:Text 'Delete'}" Command="{Binding DeleteCommand}" />
                    </StackPanel>
                    <StackPanel Spacing="2" Margin="0,0,8,0">
                      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsEditing}">
                        <Ellipse Width="10" Height="10" Fill="#C0392B" VerticalAlignment="Center" IsVisible="{Binding HasProblem}" ToolTip.Tip="{local:Text 'Not saved with the map yet: open it to see why.'}" />
                        <TextBlock Text="{Binding Name}" Classes="body row-title" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBox Text="{Binding EditText}"
                               MaxLength="60"
                               IsVisible="{Binding IsEditing}"
                               KeyDown="OnLocationNameKeyDown"
                               LostFocus="OnLocationNameLostFocus"
                               PropertyChanged="OnLocationNameBoxPropertyChanged" />
                      <TextBlock Text="{Binding Details}" Classes="caption" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="pill" Height="24" Padding="8,0" FontSize="{StaticResource FontSizeSm}" Content="{local:Text 'Open'}" Command="{Binding OpenCommand}" />
                        <Button Classes="pill" Height="24" Padding="8,0" FontSize="{StaticResource FontSizeSm}" Content="{local:Text 'Rename'}" Command="{Binding BeginEditCommand}" />
                        <Button Classes="pill" Height="24" Padding="8,0" FontSize="{StaticResource FontSizeSm}" Content="{local:Text 'Duplicate'}" Command="{Binding DuplicateCommand}" />
                      </StackPanel>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Panel>
      </DockPanel>
    </Border>

    <Border Grid.Column="1" Classes="editor-panel">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,12,0,0">
          <Panel Width="170" Height="170" HorizontalAlignment="Center">
            <local:MinimapVisual x:Name="Minimap" Width="170" Height="170" MapScale="1" />
          </Panel>
          <TextBlock Text="{local:Text 'Left button: paint · Right button: info · Screen edge, WASD or middle button: move map · Wheel: zoom · Ctrl+Z: undo · Ctrl+S: save · P: placement preview'}"
                     Classes="caption"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource SecondaryTextBrush}" />
          <Grid Classes="focus-group pill-group" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" >
            <Button x:Name="UndoButton" Grid.Row="0" Grid.Column="0" Classes="pill" local:PlateChrome.TextureSeed="1" Content="{local:Text 'Undo'}" Command="{Binding UndoCommand}" />
            <Button x:Name="SaveButton" Grid.Row="0" Grid.Column="1" Classes="pill primary" local:PlateChrome.TextureSeed="2" Content="{local:Text 'Save'}" Command="{Binding SaveCommand}" />
            <Button x:Name="BackButton" Grid.Row="1" Grid.Column="0" Classes="pill" local:PlateChrome.TextureSeed="3" Content="{local:Text 'Back'}" Command="{Binding BackCommand}" Margin="0,8,0,0" />
            <Button x:Name="PlayButton" Grid.Row="1" Grid.Column="1" Classes="pill" local:PlateChrome.TextureSeed="4" Content="{local:Text 'Save and play'}" Command="{Binding PlayCommand}" Margin="0,8,0,0" />
          </Grid>
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <!-- Events and Economy share the top row (the panel title made room for them), so they cost the tool settings
                 no height at 1366x768. -->
            <UniformGrid Columns="2">
              <Button x:Name="EventsButton" Classes="pill" local:PlateChrome.TextureSeed="7" Height="28" Margin="0,0,3,0" Content="{local:Text 'Events (V)'}" Command="{Binding ToggleEventsCommand}" />
              <Button x:Name="EconomyButton" Classes="pill" local:PlateChrome.TextureSeed="5" Height="28" Margin="3,0,0,0" Content="{local:Text 'Economy (E)'}" Command="{Binding ToggleEconomyCommand}" />
            </UniformGrid>

            <local:OutlinedTextBlock Text="{local:Text 'Name'}" Classes="caption field-label" />
            <TextBox x:Name="NameBox" Text="{Binding Name}" MaxLength="{Binding NameLength}" />

            <local:OutlinedTextBlock Text="{local:Text 'Tool'}" Classes="caption field-label" />
            <ListBox x:Name="ToolList" Classes="tools" ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedTool}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:MapEditorLabeled">
                  <TextBlock Text="{Binding Label}" Classes="body" Foreground="{StaticResource PrimaryTextBrush}" Margin="8,2" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel IsVisible="{Binding IsLandTool}">
              <local:OutlinedTextBlock Text="{local:Text 'Land type'}" Classes="caption field-label" />
              <ComboBox x:Name="LandBox" HorizontalAlignment="Stretch" ItemsSource="{Binding LandTerrains}" SelectedItem="{Binding SelectedLandTerrain}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:MapEditorLabeled">
                    <TextBlock Text="{Binding Label}" Classes="body" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <StackPanel IsVisible="{Binding IsCapitalTool}">
              <local:OutlinedTextBlock Text="{local:Text 'Capital of'}" Classes="caption field-label" />
              <ComboBox x:Name="CapitalBox" HorizontalAlignment="Stretch" ItemsSource="{Binding CapitalRaces}" SelectedItem="{Binding SelectedCapitalRace}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:MapEditorLabeled">
                    <TextBlock Text="{Binding Label}" Classes="body" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{local:Text 'Click free land to place the capital; placing it again moves it. Click the capital to set its garrison and army.'}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsArmyTool}">
              <local:OutlinedTextBlock Text="{local:Text 'Owner'}" Classes="caption field-label" />
              <ComboBox x:Name="OwnerBox" HorizontalAlignment="Stretch" ItemsSource="{Binding ArmyOwners}" SelectedItem="{Binding SelectedArmyOwner}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:MapEditorLabeled">
                    <TextBlock Text="{Binding Label}" Classes="body" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{local:Text 'Click free land to set up a new army, or click an army to change or delete it. Click a village or capital to set its garrison and army. Right-click an army to see it.'}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsVillageTool}">
              <local:OutlinedTextBlock Text="{local:Text 'Owner'}" Classes="caption field-label" />
              <ComboBox x:Name="VillageOwnerBox" HorizontalAlignment="Stretch" ItemsSource="{Binding VillageOwners}" SelectedItem="{Binding SelectedVillageOwner}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:MapEditorLabeled">
                    <TextBlock Text="{Binding Label}" Classes="body" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <local:OutlinedTextBlock Text="{local:Text 'Village level'}" Classes="caption field-label" />
              <ComboBox x:Name="VillageLevelBox" HorizontalAlignment="Stretch" ItemsSource="{Binding VillageLevels}" SelectedItem="{Binding SelectedVillageLevel}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:MapEditorLabeled">
                    <TextBlock Text="{Binding Label}" Classes="body" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{local:Text 'Click free land to found a village. Click a village to change its name, owner, level or garrison, or to delete it.'}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsResourceTool}">
              <local:OutlinedTextBlock Text="{local:Text 'Resource'}" Classes="caption field-label" />
              <ComboBox x:Name="ResourceBox" HorizontalAlignment="Stretch" ItemsSource="{Binding ResourceTypes}" SelectedItem="{Binding SelectedResourceType}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:MapEditorLabeled">
                    <TextBlock Text="{Binding Label}" Classes="body" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{local:Text 'Click land to place it; click it again to remove it. A resource pays whoever owns the land under it, so paint race land around it to give it to a player.'}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsRuinTool}">
              <TextBlock Text="{local:Text 'Click free land to place a ruin. Click a ruin to set its name, look, reward and guards, or to delete it.'}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Margin="0,10,0,0" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsBagTool}">
              <TextBlock Text="{local:Text 'Click land or water to drop a treasure bag. Click a bag to choose its items, or to delete it.'}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Margin="0,10,0,0" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsSiteTool}">
              <local:OutlinedTextBlock Text="{local:Text 'Site type'}" Classes="caption field-label" />
              <ComboBox x:Name="SiteTypeBox" HorizontalAlignment="Stretch" ItemsSource="{Binding SiteTypes}" SelectedItem="{Binding SelectedSiteType}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:MapEditorLabeled">
                    <TextBlock Text="{Binding Label}" Classes="body" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{local:Text 'Click free land to place the site. Click a site to set its name, greeting, look and goods, or to delete it.'}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsLandmarkTool}">
              <TextBlock Text="{Binding SelectedLandmark.Caption, FallbackValue=''}"
                         Classes="body"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         Margin="0,10,0,0" />
              <TextBlock Text="{local:Text 'Click land or water to place the chosen landmark; click a landmark to remove it. Armies cannot pass through landmarks.'}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsRodTool}">
              <local:OutlinedTextBlock Text="{local:Text 'Rod owner'}" Classes="caption field-label" />
              <ComboBox x:Name="RodOwnerBox" HorizontalAlignment="Stretch" ItemsSource="{Binding RodOwners}" SelectedItem="{Binding SelectedRodOwner}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:MapEditorLabeled">
                    <TextBlock Text="{Binding Label}" Classes="body" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{local:Text 'Click land to plant a rod: like in the game, it turns the nearest 2 tiles into its race land at once and 2 more every turn, and a mine those tiles reach changes owner. Rods need 2 free tiles between them. Click a rod or Shift+click to remove it; its land stays.'}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel IsVisible="{Binding IsLocationTool}">
              <local:OutlinedTextBlock Text="{local:Text 'Size'}" Classes="caption field-label" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button x:Name="LocationRadiusDownButton" Classes="pill" Width="28" Height="28" Padding="0" Content="-" Command="{Binding LocationRadiusDownCommand}" />
                <TextBlock x:Name="LocationSizeText" Text="{Binding LocationSizeText}" Classes="body" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" TextAlignment="Center" MinWidth="44" />
                <Button x:Name="LocationRadiusUpButton" Classes="pill" Width="28" Height="28" Padding="0" Content="+" Command="{Binding LocationRadiusUpCommand}" />
                <Button x:Name="LocationsButton" Classes="pill" local:PlateChrome.TextureSeed="6" Height="28" Padding="10,0" Margin="8,0,0,0" Content="{local:Text 'List (L)'}" Command="{Binding ToggleLocationsCommand}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0" IsVisible="{Binding HasSelectedLocation}">
                <TextBlock Text="{local:Text 'X'}" Classes="body" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                <TextBox x:Name="LocationXBox" Width="56" Text="{Binding LocationXText}" KeyDown="OnLocationPositionKeyDown" LostFocus="OnLocationPositionLostFocus" />
                <TextBlock Text="{local:Text 'Y'}" Classes="body" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                <TextBox x:Name="LocationYBox" Width="56" Text="{Binding LocationYText}" KeyDown="OnLocationPositionKeyDown" LostFocus="OnLocationPositionLostFocus" />
              </StackPanel>
              <TextBlock Text="{local:Text 'Click the map to place a named zone (+ and - change its size), then type its name. Click a zone to select it, drag it to move it, Ctrl+click to place a zone inside it, Shift+click to remove it. Zones may overlap; near the edge they move inside the map.'}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel IsVisible="{Binding IsRoadTool}">
              <TextBlock Text="{local:Text 'Click a tile to start a road, then move the mouse: the road takes the best way there, around water, mountains and buildings, and joins the roads it meets. Click again to lay it and carry on from there. Click the last tile again or press Esc to stop. Shift+click removes a road tile. Armies move faster on roads.'}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Margin="0,10,0,0" />
            </StackPanel>

            <StackPanel IsVisible="{Binding HasBrush}">

              <local:OutlinedTextBlock Text="{local:Text 'Brush size'}" Classes="caption field-label" />
              <Slider x:Name="BrushSlider" Minimum="0" Maximum="{Binding MaxBrush}" Value="{Binding BrushRadius}" IsSnapToTickEnabled="True" TickFrequency="1" />
            </StackPanel>

            <CheckBox x:Name="PreviewBox" IsChecked="{Binding IsPreviewEnabled}" Margin="0,12,0,0">
              <TextBlock Text="{local:Text 'Placement preview (P)'}" Classes="body" Foreground="{StaticResource PrimaryTextBrush}" />
            </CheckBox>

            <local:OutlinedTextBlock Text="{local:Text 'Status'}" Classes="caption field-label" />
            <TextBlock Text="{Binding Status}"
                       Classes="body"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource PrimaryTextBrush}" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>

</UserControl>
