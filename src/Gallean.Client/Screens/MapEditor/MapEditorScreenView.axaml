<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Gallean.Client"
             xmlns:texts="clr-namespace:Gallean.Client.Texts;assembly=Gallean.Client.Texts"
             x:Class="Gallean.Client.MapEditorScreenView"
             x:DataType="local:MapEditorScreenViewModel">

  <!-- Copied from WorldScreenView: used by the right-click info templates below. -->
  <UserControl.Resources>
    <ControlTheme x:Key="UnitGroupInfoUnitContainerTheme" TargetType="ContentPresenter" x:DataType="local:WorldUnitGroupInfoUnitViewModel">
      <Setter Property="Grid.Row" Value="{Binding Row}" />
      <Setter Property="Grid.Column" Value="{Binding Column}" />
      <Setter Property="Grid.ColumnSpan" Value="{Binding ColumnSpan}" />
    </ControlTheme>

    <DataTemplate x:Key="UnitGroupInfoUnitTemplate" x:DataType="local:WorldUnitGroupInfoUnitViewModel">
      <local:UnitPortrait FaceKey="{Binding FaceKey}"
                          Hitpoints="{Binding Hitpoints}"
                          MaxHitpoints="{Binding MaxHitpoints}"
                          IsDead="{Binding !IsAlive}"
                          Statuses="{Binding Statuses}"
                          StatusTemplate="{StaticResource UnitStatusBadgeTemplate}">
        <local:OutlinedTextBlock Classes="object-name compact unit-group-info-name" Text="{Binding Name}" />
      </local:UnitPortrait>
    </DataTemplate>

    <DataTemplate x:Key="UnitGroupInfoGridTemplate" x:DataType="local:WorldUnitGroupInfoGridViewModel">
      <Grid Width="230" Height="414" local:PortraitScope.IsFacingLeft="{Binding IsFacingLeft}">
        <UniformGrid Rows="3" Columns="2">
          <local:UnitPortrait />
          <local:UnitPortrait />
          <local:UnitPortrait />
          <local:UnitPortrait />
          <local:UnitPortrait />
          <local:UnitPortrait />
        </UniformGrid>
        <ItemsControl ItemsSource="{Binding Units}"
                      ClipToBounds="False"
                      ItemContainerTheme="{StaticResource UnitGroupInfoUnitContainerTheme}"
                      ItemTemplate="{StaticResource UnitGroupInfoUnitTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Grid RowDefinitions="*,*,*" ColumnDefinitions="*,*" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="UnitGroupInfoLineTemplate" x:DataType="texts:TextSpans">
      <local:OutlinedTextBlock local:TextRuns.Spans="{Binding}"
                               Classes="body"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap" />
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <StyleInclude Source="avares://Gallean.Client/Screens/World/WorldChrome.axaml" />
    <Style Selector="local|OutlinedTextBlock.unit-group-info-name">
      <Setter Property="Margin" Value="4,0,4,20" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector=":is(TextBlock).unit-group-info-header">
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector=":is(TextBlock).field-label">
      <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
    <Style Selector="ListBox.tools > ListBoxItem">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.palette > ListBoxItem">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="2" />
    </Style>
    <Style Selector="Border.editor-panel">
      <Setter Property="Background" Value="{StaticResource ModalBackdropBrush}" />
      <Setter Property="Width" Value="340" />
      <Setter Property="Padding" Value="20,16" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,Auto" Background="Black">
    <local:MapEditorVisual x:Name="Map" Grid.Column="0" />

    <local:OutlinedTextBlock Grid.Column="0"
                             Text="{Binding HoverText}"
                             Classes="caption"
                             Foreground="{StaticResource PrimaryTextBrush}"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Bottom"
                             Margin="12,8"
                             IsHitTestVisible="False" />

    <!-- Right-click info: the same templates as the world screen's position info popup. -->
    <Popup x:Name="PositionInfoPopup"
           Grid.Column="0"
           IsOpen="{Binding PositionInfo, Converter={x:Static ObjectConverters.IsNotNull}}"
           PlacementTarget="{Binding #Map}"
           Placement="AnchorAndGravity"
           PlacementAnchor="Right"
           PlacementGravity="Right"
           PlacementConstraintAdjustment="FlipX,SlideX,SlideY"
           IsHitTestVisible="False">
      <ContentControl Classes="cached" Content="{Binding PositionInfo}">
        <ContentControl.DataTemplates>
          <DataTemplate x:DataType="local:WorldStackInfoViewModel">
            <local:ModalFrameDecorator Padding="16" Margin="0,40,0,0">
              <Grid ColumnDefinitions="260,Auto" ColumnSpacing="16">
                <DockPanel Grid.Column="0">
                  <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,12,0,0">
                    <local:OutlinedTextBlock Text="{Binding LeaderName}"
                                             Classes="object-name row"
                                             HorizontalAlignment="Center"
                                             TextTrimming="CharacterEllipsis" />
                    <local:OutlinedTextBlock Text="{Binding RaceName}"
                                             Classes="body"
                                             Foreground="{StaticResource SecondaryTextBrush}"
                                             HorizontalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource UnitGroupInfoLineTemplate}" />
                  </StackPanel>
                  <local:PointerTiltDecorator Classes="event-portrait" Margin="-24,-56,-24,-20">
                    <local:SpriteVisual SpriteKey="{Binding LeaderPortraitKey}" Stretch="Uniform" />
                  </local:PointerTiltDecorator>
                </DockPanel>
                <Panel Grid.Column="1">
                  <ContentControl Content="{Binding Grid}"
                                  ContentTemplate="{StaticResource UnitGroupInfoGridTemplate}"
                                  ClipToBounds="False"
                                  IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNull}}" />
                  <local:OutlinedTextBlock Text="{Binding Note}"
                                           IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}"
                                           Classes="body"
                                           Width="230"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center" />
                </Panel>
              </Grid>
            </local:ModalFrameDecorator>
          </DataTemplate>
          <DataTemplate x:DataType="local:WorldFortificationInfoViewModel">
            <local:ModalFrameDecorator Padding="16,12,16,16">
              <StackPanel Spacing="8">
                <local:OutlinedTextBlock Text="{Binding Title}"
                                         Classes="h4"
                                         Foreground="{StaticResource PrimaryTextBrush}"
                                         HorizontalAlignment="Center" />
                <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource UnitGroupInfoLineTemplate}" />
                <Rectangle Classes="details-rule" />
                <local:OutlinedTextBlock Text="{Binding Note}"
                                         IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}"
                                         Classes="body"
                                         MaxWidth="476"
                                         Foreground="{StaticResource PrimaryTextBrush}"
                                         TextWrapping="Wrap"
                                         TextAlignment="Center" />
                <Grid ColumnDefinitions="Auto,Auto"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="16"
                      RowSpacing="4"
                      IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNull}}">
                  <local:OutlinedTextBlock Grid.Column="0"
                                           Grid.Row="0"
                                           Text="{Binding VisitingStackTitle}"
                                           Classes="body unit-group-info-header"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                  <local:OutlinedTextBlock Grid.Column="1"
                                           Grid.Row="0"
                                           Text="{local:Text 'City defenses'}"
                                           Classes="body unit-group-info-header"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           HorizontalAlignment="Center" />
                  <ContentControl Grid.Column="0"
                                  Grid.Row="1"
                                  Content="{Binding VisitingStack}"
                                  ContentTemplate="{StaticResource UnitGroupInfoGridTemplate}"
                                  ClipToBounds="False" />
                  <ContentControl Grid.Column="1"
                                  Grid.Row="1"
                                  Content="{Binding Defenses}"
                                  ContentTemplate="{StaticResource UnitGroupInfoGridTemplate}"
                                  ClipToBounds="False" />
                </Grid>
              </StackPanel>
            </local:ModalFrameDecorator>
          </DataTemplate>
          <DataTemplate x:DataType="local:WorldTileInfoViewModel">
            <local:ModalFrameDecorator Width="300" Padding="20,16">
              <StackPanel Spacing="8">
                <local:OutlinedTextBlock Text="{Binding Title}"
                                         Classes="h4"
                                         Foreground="{StaticResource PrimaryTextBrush}"
                                         HorizontalAlignment="Center"
                                         TextAlignment="Center"
                                         TextWrapping="Wrap" />
                <Rectangle Classes="details-rule" IsVisible="{Binding HasDetails}" />
                <ItemsControl ItemsSource="{Binding Lines}"
                              ItemTemplate="{StaticResource UnitGroupInfoLineTemplate}"
                              IsVisible="{Binding Lines.Count, Converter={x:Static local:GreaterThanConverter.Instance}, ConverterParameter=0}" />
                <ItemsControl ItemsSource="{Binding Tombs}"
                              IsVisible="{Binding Tombs.Count, Converter={x:Static local:GreaterThanConverter.Instance}, ConverterParameter=0}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="texts:TextSpans">
                      <local:OutlinedTextBlock Classes="body"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               local:TextRuns.Spans="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ContentControl Content="{Binding Garrison}"
                                ContentTemplate="{StaticResource UnitGroupInfoGridTemplate}"
                                IsVisible="{Binding Garrison, Converter={x:Static ObjectConverters.IsNotNull}}"
                                HorizontalAlignment="Center"
                                ClipToBounds="False" />
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="12"
                      IsVisible="{Binding Item, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <Panel Grid.Column="0" Classes="inventory-slot">
                    <local:PlateChrome Classes="socket" />
                    <local:SpriteVisual SpriteKey="{Binding Item.SpriteKey, FallbackValue={x:Null}}" Stretch="Uniform" />
                  </Panel>
                  <local:OutlinedTextBlock Grid.Column="1"
                                           Text="{Binding Item.Name, FallbackValue=''}"
                                           Classes="object-name row"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                </Grid>
                <ContentControl Content="{Binding Reward}"
                                Classes="body"
                                IsVisible="{Binding Reward, Converter={x:Static ObjectConverters.IsNotNull}}"
                                HorizontalAlignment="Center"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                <StackPanel Orientation="Horizontal"
                            Spacing="6"
                            IsVisible="{Binding Income, Converter={x:Static ObjectConverters.IsNotNull}}"
                            HorizontalAlignment="Center">
                  <local:OutlinedTextBlock Text="{local:Text 'Income:'}"
                                           Classes="body"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" />
                  <ContentControl Content="{Binding Income}"
                                  Classes="body"
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource PrimaryTextBrush}" />
                </StackPanel>
              </StackPanel>
            </local:ModalFrameDecorator>
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Popup>

    <!-- The landmark palette sits over the left of the map, so it gets the full height at any window size. -->
    <Border Grid.Column="0"
            Classes="editor-panel"
            HorizontalAlignment="Left"
            Margin="0,0,0,40"
            IsVisible="{Binding IsLandmarkTool}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <local:OutlinedTextBlock Text="{local:Text 'Landmarks'}" Classes="h4" Foreground="{StaticResource ScenarioSelectAccentBrush}" />
          <Grid ColumnDefinitions="*,8,*" Margin="0,10,0,8">
            <ComboBox x:Name="LandmarkCategoryBox" Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding LandmarkCategories}" SelectedItem="{Binding SelectedLandmarkCategory}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="local:MapEditorLabeled">
                  <TextBlock Text="{Binding Label}" Classes="body" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox x:Name="LandmarkSizeBox" Grid.Column="2" HorizontalAlignment="Stretch" ItemsSource="{Binding LandmarkSizes}" SelectedItem="{Binding SelectedLandmarkSize}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="local:MapEditorLabeled">
                  <TextBlock Text="{Binding Label}" Classes="body" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
        </StackPanel>
        <ListBox x:Name="LandmarkPalette"
                 Classes="palette"
                 ItemsSource="{Binding Landmarks}"
                 SelectedItem="{Binding SelectedLandmark}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:MapEditorLandmarkOption">
              <local:AnimationVisual AnimationKey="{Binding PreviewKey}"
                                     Width="68"
                                     Height="68"
                                     Stretch="Uniform"
                                     ToolTip.Tip="{Binding Caption}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <Border Grid.Column="1" Classes="editor-panel">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,12,0,0">
          <Panel Width="170" Height="170" HorizontalAlignment="Center">
            <local:MinimapVisual x:Name="Minimap" Width="170" Height="170" MapScale="1" />
          </Panel>
          <TextBlock Text="{local:Text 'Left button: paint · Right button: info · Screen edge, WASD or middle button: move map · Wheel: zoom · Ctrl+Z: undo · Ctrl+S: save · P: placement preview'}"
                     Classes="caption"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource SecondaryTextBrush}" />
          <Grid Classes="focus-group pill-group" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" >
            <Button x:Name="UndoButton" Grid.Row="0" Grid.Column="0" Classes="pill" local:PlateChrome.TextureSeed="1" Content="{local:Text 'Undo'}" Command="{Binding UndoCommand}" />
            <Button x:Name="SaveButton" Grid.Row="0" Grid.Column="1" Classes="pill primary" local:PlateChrome.TextureSeed="2" Content="{local:Text 'Save'}" Command="{Binding SaveCommand}" />
            <Button x:Name="BackButton" Grid.Row="1" Grid.Column="0" Classes="pill" local:PlateChrome.TextureSeed="3" Content="{local:Text 'Back'}" Command="{Binding BackCommand}" Margin="0,8,0,0" />
            <Button x:Name="PlayButton" Grid.Row="1" Grid.Column="1" Classes="pill" local:PlateChrome.TextureSeed="4" Content="{local:Text 'Save and play'}" Command="{Binding PlayCommand}" Margin="0,8,0,0" />
          </Grid>
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <local:OutlinedTextBlock Text="{local:Text 'Map editor'}" Classes="h4" Foreground="{StaticResource ScenarioSelectAccentBrush}" />

            <local:OutlinedTextBlock Text="{local:Text 'Name'}" Classes="caption field-label" />
            <TextBox x:Name="NameBox" Text="{Binding Name}" MaxLength="{Binding NameLength}" />

            <local:OutlinedTextBlock Text="{local:Text 'Tool'}" Classes="caption field-label" />
            <ListBox x:Name="ToolList" Classes="tools" ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedTool}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:MapEditorLabeled">
                  <TextBlock Text="{Binding Label}" Classes="body" Foreground="{StaticResource PrimaryTextBrush}" Margin="8,4" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel IsVisible="{Binding IsLandTool}">
              <local:OutlinedTextBlock Text="{local:Text 'Land type'}" Classes="caption field-label" />
              <ComboBox x:Name="LandBox" HorizontalAlignment="Stretch" ItemsSource="{Binding LandTerrains}" SelectedItem="{Binding SelectedLandTerrain}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:MapEditorLabeled">
                    <TextBlock Text="{Binding Label}" Classes="body" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <StackPanel IsVisible="{Binding IsCapitalTool}">
              <local:OutlinedTextBlock Text="{local:Text 'Capital of'}" Classes="caption field-label" />
              <ComboBox x:Name="CapitalBox" HorizontalAlignment="Stretch" ItemsSource="{Binding CapitalRaces}" SelectedItem="{Binding SelectedCapitalRace}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:MapEditorLabeled">
                    <TextBlock Text="{Binding Label}" Classes="body" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{local:Text 'Click free land to place the capital; placing it again moves it. Click the capital to set its garrison and army.'}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsArmyTool}">
              <local:OutlinedTextBlock Text="{local:Text 'Owner'}" Classes="caption field-label" />
              <ComboBox x:Name="OwnerBox" HorizontalAlignment="Stretch" ItemsSource="{Binding ArmyOwners}" SelectedItem="{Binding SelectedArmyOwner}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:MapEditorLabeled">
                    <TextBlock Text="{Binding Label}" Classes="body" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{local:Text 'Click free land to set up a new army, or click an army to change or delete it. Click a village or capital to set its garrison and army. Right-click an army to see it.'}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsVillageTool}">
              <local:OutlinedTextBlock Text="{local:Text 'Owner'}" Classes="caption field-label" />
              <ComboBox x:Name="VillageOwnerBox" HorizontalAlignment="Stretch" ItemsSource="{Binding VillageOwners}" SelectedItem="{Binding SelectedVillageOwner}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:MapEditorLabeled">
                    <TextBlock Text="{Binding Label}" Classes="body" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <local:OutlinedTextBlock Text="{local:Text 'Village level'}" Classes="caption field-label" />
              <ComboBox x:Name="VillageLevelBox" HorizontalAlignment="Stretch" ItemsSource="{Binding VillageLevels}" SelectedItem="{Binding SelectedVillageLevel}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:MapEditorLabeled">
                    <TextBlock Text="{Binding Label}" Classes="body" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{local:Text 'Click free land to found a village. Click a village to change its name, owner, level or garrison, or to delete it.'}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsResourceTool}">
              <local:OutlinedTextBlock Text="{local:Text 'Resource'}" Classes="caption field-label" />
              <ComboBox x:Name="ResourceBox" HorizontalAlignment="Stretch" ItemsSource="{Binding ResourceTypes}" SelectedItem="{Binding SelectedResourceType}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:MapEditorLabeled">
                    <TextBlock Text="{Binding Label}" Classes="body" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{local:Text 'Click land to place it; click it again to remove it. A resource pays whoever owns the land under it, so paint race land around it to give it to a player.'}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsRuinTool}">
              <TextBlock Text="{local:Text 'Click free land to place a ruin. Click a ruin to set its name, look, reward and guards, or to delete it.'}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Margin="0,10,0,0" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsBagTool}">
              <TextBlock Text="{local:Text 'Click land or water to drop a treasure bag. Click a bag to choose its items, or to delete it.'}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Margin="0,10,0,0" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsSiteTool}">
              <local:OutlinedTextBlock Text="{local:Text 'Site type'}" Classes="caption field-label" />
              <ComboBox x:Name="SiteTypeBox" HorizontalAlignment="Stretch" ItemsSource="{Binding SiteTypes}" SelectedItem="{Binding SelectedSiteType}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:MapEditorLabeled">
                    <TextBlock Text="{Binding Label}" Classes="body" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{local:Text 'Click free land to place the site. Click a site to set its name, greeting, look and goods, or to delete it.'}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsLandmarkTool}">
              <TextBlock Text="{Binding SelectedLandmark.Caption, FallbackValue=''}"
                         Classes="body"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         Margin="0,10,0,0" />
              <TextBlock Text="{local:Text 'Click land or water to place the chosen landmark; click a landmark to remove it. Armies cannot pass through landmarks.'}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsRodTool}">
              <local:OutlinedTextBlock Text="{local:Text 'Rod owner'}" Classes="caption field-label" />
              <ComboBox x:Name="RodOwnerBox" HorizontalAlignment="Stretch" ItemsSource="{Binding RodOwners}" SelectedItem="{Binding SelectedRodOwner}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:MapEditorLabeled">
                    <TextBlock Text="{Binding Label}" Classes="body" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{local:Text 'Click land to plant a rod: like in the game, it turns the nearest 2 tiles into its race land at once and 2 more every turn, and a mine those tiles reach changes owner. Rods need 2 free tiles between them. Click a rod or Shift+click to remove it; its land stays.'}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel IsVisible="{Binding IsRoadTool}">
              <TextBlock Text="{local:Text 'Click a tile to start a road, then move the mouse: the road takes the best way there, around water, mountains and buildings, and joins the roads it meets. Click again to lay it and carry on from there. Click the last tile again or press Esc to stop. Shift+click removes a road tile. Armies move faster on roads.'}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Margin="0,10,0,0" />
            </StackPanel>

            <StackPanel IsVisible="{Binding HasBrush}">

              <local:OutlinedTextBlock Text="{local:Text 'Brush size'}" Classes="caption field-label" />
              <Slider x:Name="BrushSlider" Minimum="0" Maximum="{Binding MaxBrush}" Value="{Binding BrushRadius}" IsSnapToTickEnabled="True" TickFrequency="1" />
            </StackPanel>

            <CheckBox x:Name="PreviewBox" IsChecked="{Binding IsPreviewEnabled}" Margin="0,12,0,0">
              <TextBlock Text="{local:Text 'Placement preview (P)'}" Classes="body" Foreground="{StaticResource PrimaryTextBrush}" />
            </CheckBox>

            <local:OutlinedTextBlock Text="{local:Text 'Status'}" Classes="caption field-label" />
            <TextBlock Text="{Binding Status}"
                       Classes="body"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource PrimaryTextBrush}" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>

</UserControl>
