<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Gallean.Client"
             x:Class="Gallean.Client.MapEditorUnitPickerView"
             x:DataType="local:MapEditorUnitPickerViewModel">

  <UserControl.Styles>
    <Style Selector="ListBox.race-filter > ListBoxItem">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Button.row.unavailable">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
  </UserControl.Styles>

  <Border Background="{StaticResource ModalBackdropBrush}" local:Backdrop.CloseCommand="{Binding CloseCommand}">
    <local:ModalPanel Width="560" MaxHeight="700" Title="{Binding Title}" InitialFocus="{Binding #CloseButton}">

      <local:ModalPanel.Footer>
        <Button x:Name="CloseButton"
                Content="{local:Text 'Cancel'}"
                Classes="pill"
                MinWidth="110"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Command="{Binding CloseCommand}" />
      </local:ModalPanel.Footer>

      <DockPanel>
        <ListBox x:Name="RaceFilter"
                 DockPanel.Dock="Top"
                 Classes="race-filter"
                 Margin="0,0,0,10"
                 ItemsSource="{Binding Filters}"
                 SelectedItem="{Binding SelectedFilter}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:MapEditorRaceFilter">
              <TextBlock Text="{Binding Label}" Classes="body" Foreground="{StaticResource PrimaryTextBrush}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <ScrollViewer Classes="list">
          <ItemsControl x:Name="OptionList" Classes="focus-group" ItemsSource="{Binding Options}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:MapEditorUnitPickerItemViewModel">
                <Button Classes="row" Classes.unavailable="{Binding IsUnavailable}" Command="{Binding PickCommand}">
                  <Grid ColumnDefinitions="64,*">
                    <local:UnitIcon Grid.Column="0" SpriteKey="{Binding PortraitKey}" Width="64" Height="64" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                      <local:OutlinedTextBlock Text="{Binding Name}" Classes="object-name row" />
                      <TextBlock Text="{Binding Description}"
                                 Classes="caption"
                                 Foreground="{StaticResource PrimaryTextBrush}"
                                 TextWrapping="Wrap"
                                 MaxLines="3"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Info}" Classes="caption" Foreground="{StaticResource SecondaryTextBrush}" />
                      <TextBlock Text="{Binding UnavailableReason}"
                                 Classes="caption"
                                 Foreground="{StaticResource AccentBrush}"
                                 IsVisible="{Binding IsUnavailable}" />
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

    </local:ModalPanel>
  </Border>

</UserControl>
