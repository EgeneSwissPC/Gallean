<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Gallean.Client"
             x:Class="Gallean.Client.MapEditorVariablesScreenView"
             x:DataType="local:MapEditorVariablesScreenViewModel">

  <Grid Background="{StaticResource ModalBackdropBrush}" local:Backdrop.CloseCommand="{Binding CloseCommand}">
    <ContentControl Classes="ornament-panel"
                    Background="{StaticResource CapitalScenePanelBodyGradientBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
      <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24,14" Width="640" Height="520">
        <local:OutlinedTextBlock Grid.Row="0" Text="{local:Text 'Variables'}" Classes="object-name title" HorizontalAlignment="Center" />
        <TextBlock Grid.Row="1" Margin="0,4,0,8" Classes="caption" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"
                   Text="{local:Text 'Whole numbers every event can test (a variable is in a range) and change (change a variable): count villages taken, remember that the elder was met.'}" />

        <Panel Grid.Row="2">
          <TextBlock Text="{local:Text 'No variables yet. Click New variable.'}" Classes="caption" Foreground="{StaticResource SecondaryTextBrush}" IsVisible="{Binding HasNoRows}" />
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="VariableList" ItemsSource="{Binding Rows}" Focusable="True">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:MapEditorVariableRowViewModel">
                  <Border Padding="8,6" Margin="0,2" Background="#22000000" CornerRadius="4">
                    <Grid ColumnDefinitions="260,Auto,80,*,Auto" ColumnSpacing="8">
                      <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" MaxLength="40" KeyDown="OnBoxKeyDown" />
                      <TextBlock Grid.Column="1" Text="{local:Text 'starts at'}" Classes="body" VerticalAlignment="Center" />
                      <TextBox Grid.Column="2" Text="{Binding InitialText, UpdateSourceTrigger=LostFocus}" TextAlignment="Center" KeyDown="OnBoxKeyDown" />
                      <TextBlock Grid.Column="3" Text="{Binding UsedBy}" Classes="caption" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                      <Button Grid.Column="4" Classes="pill" Width="28" Height="28" Padding="0" Content="×" ToolTip.Tip="{local:Text 'Delete'}" Command="{Binding DeleteCommand}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Panel>

        <StackPanel Grid.Row="3" Margin="0,10,0,0" Classes="focus-group" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
          <Button x:Name="NewVariableButton" Classes="pill primary" local:PlateChrome.TextureSeed="6" MinWidth="140" Content="{local:Text 'New variable'}" Command="{Binding NewVariableCommand}" />
          <Button x:Name="CloseButton" Classes="pill" local:PlateChrome.TextureSeed="5" MinWidth="140" Content="{local:Text 'Close'}" Command="{Binding CloseCommand}" />
        </StackPanel>
      </Grid>
    </ContentControl>
  </Grid>

</UserControl>
