<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Gallean.Client"
             x:Class="Gallean.Client.SpellGroupsTabView"
             x:Name="Screen"
             x:DataType="local:SpellGroupsTabViewModel">

  <UserControl.Styles>
    <Style Selector="Border.group-spell-icon">
      <Setter Property="Width" Value="52" />
      <Setter Property="Height" Value="52" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.group-spell-icon.unavailable">
      <Setter Property="BorderBrush" Value="{StaticResource SpellLockedInkBrush}" />
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Border.group-spell-badge TextBlock">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Border.group-spell-badge">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="-4,-4,0,0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Background" Value="#F2181410" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Styles>

  <Grid Background="Transparent" local:Backdrop.CloseCommand="{Binding Screen.CloseCommand}">
    <ContentControl Classes="ornament-panel" MaxWidth="900" MaxHeight="660" Margin="18" Padding="22,18,10,10">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0"
                   Margin="0,0,12,12"
                   Text="{local:Text 'A group casts its spells one after another, in this order.'}"
                   Classes="body"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   FontStyle="Italic" />
        <ScrollViewer Grid.Row="1" Background="Transparent" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl Margin="0,0,12,0" ItemsSource="{Binding Groups}">
            <local:Blankslate.Content>
              <TextBlock Text="{local:Text 'No spell groups yet. Make one with Create spell group in the Spellbook.'}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}" />
            </local:Blankslate.Content>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:SpellGroupRowViewModel">
                <Border Classes="card" Margin="0,0,0,10" Padding="14,10">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" Spacing="6">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <local:OutlinedTextBlock Grid.Column="0" Text="{Binding Name}" Classes="label" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ReadyText}" Classes="caption" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                      </Grid>
                      <ItemsControl ItemsSource="{Binding SpellItems}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel ItemSpacing="8" LineSpacing="6" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="local:SpellGroupSpellViewModel">
                            <Panel ToolTip.Tip="{Binding Details.Name}" Margin="4,4,0,0">
                              <Border Classes="spell-icon group-spell-icon"
                                      Classes.unavailable="{Binding !IsCastable}"
                                      Classes.dark-background="{Binding Details.Icon.Background, Converter={x:Static local:EnumEqualsConverter.Instance}, ConverterParameter={x:Static local:IconViewModel+Spell+BackgroundType.Dark}}">
                                <local:SpriteVisual SpriteKey="{Binding Details.Icon.Key}" Stretch="UniformToFill" />
                              </Border>
                              <Border Classes="group-spell-badge">
                                <TextBlock Text="{Binding Position}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                              </Border>
                            </Panel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <ContentControl Content="{Binding Status}" Classes="caption" IsVisible="{Binding Status.IsReasonVisible}" />
                    </StackPanel>
                    <local:PriceButton Grid.Column="1"
                                       Classes="pill"
                                       local:PlateChrome.TextureSeed="1"
                                       Content="{Binding CastText}"
                                       Status="{Binding Status}"
                                       Command="{Binding CastCommand}"
                                       MinWidth="150"
                                       VerticalAlignment="Center" />
                    <Button Grid.Column="2"
                            Classes="pill danger"
                            local:PlateChrome.TextureSeed="2"
                            Command="{Binding DeleteCommand}"
                            ToolTip.Tip="{local:Text 'Delete'}"
                            VerticalAlignment="Center">
                      <local:IconVisual Moniker="Delete"
                                        Width="18"
                                        Height="18"
                                        Foreground="{Binding $parent[Button].Foreground}" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </ContentControl>
  </Grid>

</UserControl>
