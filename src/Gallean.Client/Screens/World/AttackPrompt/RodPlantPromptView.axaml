<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Gallean.Client"
             x:Class="Gallean.Client.RodPlantPromptView"
             x:DataType="local:RodPlantPromptViewModel">

  <!-- Gallean Upgrade: auto rod (docs/auto-rod.md). Same frame as MoveOrderPromptView. -->
  <Border Background="{StaticResource ModalBackdropBrush}">
    <local:ModalPanel Classes="accent" Width="640" Padding="28,10,28,24" Title="{local:Text 'Plant rod'}" InitialFocus="{Binding #PlantButton}">

      <local:ModalPanel.Footer>
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,*">
          <Button x:Name="PlantButton"
                  Grid.Column="1"
                  Content="{local:Text 'Plant rod'}"
                  Classes="pill primary"
                  local:PlateChrome.TextureSeed="1"
                  Command="{Binding PlantCommand}"
                  MinWidth="150"
                  Margin="0,0,12,0" />
          <Button Grid.Column="2"
                  Content="{local:Text 'Skip this spot'}"
                  Classes="pill"
                  local:PlateChrome.TextureSeed="2"
                  Command="{Binding SkipCommand}"
                  MinWidth="150"
                  Margin="0,0,12,0" />
          <Button Grid.Column="3"
                  Content="{local:Text 'Stop auto rod'}"
                  Classes="pill"
                  local:PlateChrome.TextureSeed="3"
                  Command="{Binding StopCommand}"
                  MinWidth="150" />
        </Grid>
      </local:ModalPanel.Footer>

      <StackPanel Spacing="16" Margin="0,26,0,12">
        <local:IconVisual Moniker="PlantRod"
                          Width="48"
                          Height="48"
                          HorizontalAlignment="Center"
                          Foreground="{StaticResource PrimaryTextBrush}" />
        <TextBlock Classes="body"
                   Foreground="{StaticResource PrimaryTextBrush}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Text="{Binding Message}" />
      </StackPanel>

    </local:ModalPanel>
  </Border>

</UserControl>
